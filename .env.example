# FollowSM API key (leave empty to run on the free, IP-rate-limited tier).
# Get a DEVELOPER / ENTERPRISE key: https://follow-sm.com/pricing
FOLLOWSM_API_KEY=

# Polygon private key of the wallet that signs Polymarket CLOB orders.
# Only required when LIVE_TRADING=true. NEVER commit a real key.
POLYMARKET_PRIVATE_KEY=

# Optional: proxy/Safe wallet that holds your funds (set when signing via a proxy).
POLYMARKET_FUNDER=
# 0 = EOA, 1 = Polymarket email/Magic proxy, 2 = browser-wallet Safe proxy.
POLYMARKET_SIGNATURE_TYPE=0

# false = paper trading against live Polymarket midpoints (no orders are sent).
LIVE_TRADING=false

SYMBOL=BTCUSDT
POLL_INTERVAL_SECS=5
QUOTE_SIZE=10
BASE_HALF_SPREAD=0.02

# Custom RiskConfig thresholds (override the backend's defaults).
# vpin_percentile = VPIN ranked against the symbol's own recent history (0-1).
VPIN_PERCENTILE_WIDEN_THRESHOLD=0.90
VPIN_PERCENTILE_HALT_THRESHOLD=0.95
# Raw-VPIN fallback, used only while the backend has not published vpin_percentile yet.
VPIN_WIDEN_THRESHOLD=0.80
VPIN_HALT_THRESHOLD=0.90
MIN_SEMANTIC_CONFIDENCE=0.65
